# Copy to .env and fill in. Share real keys through a password manager, never in chat or the repo.
X_BEARER_TOKEN=
XAI_API_KEY=
DAYTONA_API_KEY=
FACTORY_API_KEY=
# Photon SMS (api/photon.py): texts the enrolled phone when a case is filed or X misses the 48 hours.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
HF_TOKEN=
# Modal uses `modal token new` instead of an env var.

# Never file real TAKE IT DOWN notices for test posts.
DRY_RUN=1
# How long after a notice before we recheck X. 172800 is 48 hours (the Act). 5 is a local demo.
NOTICE_DEADLINE_SECONDS=5
# Who signs notices as the user's authorized representative (a real team member), and the team's
# reporting inbox that platforms reply to. See api/templates/NOTES.md.
SIGNER_NAME=
CONTACT_EMAIL=
# With DRY_RUN=1, confirmed cases' notice packets are emailed here (yours), never to a platform.
NOTICE_TEST_TO=
# Outgoing email for the test packets. Gmail: smtp.gmail.com, 587, your address, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTICE_FROM=
# The case worker (api/caseworker.py) runs when the droid CLI is installed and FACTORY_API_KEY is set.
# It owns the 48-hour wait (wait_until). 0 turns it off. For a demo, POST /timewarp/{case_id}
# skips a test case's wait. NOTICE_DEADLINE_SECONDS=5 fits in one Factory session.
CASEWORKER=1
CASEWORKER_MODEL=auto
